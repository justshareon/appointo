        }
        const user = await db.getUserById(req.user.id);
        const saved = await db.submitMatchmakingAnswers({
            vendor_id,
            user_id: req.user.id,
            answers,
            user_name: user?.name || 'User'
        });
        res.json({ success: true, result: saved });
