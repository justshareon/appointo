app.get('/api/vendors/:id/matchmaking/template', async (req, res, next) => {
    try {
        // Let explicit self/me routes handle these reserved IDs.
        if (req.params.id === 'me' || req.params.id === 'self') {
            return next();
        }
        const vendor = await db.getVendorById(req.params.id);
        if (!vendor || vendor.features_matchmaking === false) {
            return res.status(404).json({ error: "Matchmaking is not enabled for this vendor." });
        }
        const template = await db.getVendorMatchmakingTemplate(req.params.id);
        if (!template || template.is_active === false) {
            return res.status(404).json({ error: "No active matchmaking template found." });
        }
        res.json({
            vendor_id: req.params.id,
            template_name: template.template_name,
            selected_preset: template.selected_preset,
            scoring: template.scoring,
            questions: template.questions
        });
    } catch (err) {
        LOG.error("Failed to fetch vendor matchmaking template", err.message);
        res.status(500).json({ error: err.message });
    }
});

