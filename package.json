{
  "name": "qr-queue-backend",
  "version": "1.0.0",
  "description": "MySQL + Node.js Backend for QR Queue SaaS",
  "main": "server.js",
  "scripts": {
    "prestart": "node -e \"['cors','express','mysql2','dotenv','socket.io'].forEach(m=>{try{require.resolve(m)}catch(e){console.error('Missing '+m+'. Run: npm install');process.exit(1)}})\"",
    "verify:deploy": "node verifyDeploy.js",
    "predeploy": "node verifyDeploy.js",
    "start": "node --max-old-space-size=2048 --expose-gc server.js",
    "start:inmemory": "set DB_TYPE=inmemory&& node --max-old-space-size=2048 --expose-gc server.js",
    "start:mysql": "set DB_TYPE=mysql&& node --max-old-space-size=2048 --expose-gc server.js",
    "dev": "node --max-old-space-size=2048 --expose-gc server.js",
    "sync:all": "node syncAllToMysql.js",
    "sync:3h": "node syncLast3Hours.js",
    "sync:users": "set DB_TYPE=mysql&& node -e \"const {syncUsers}=require('./syncAllToMysql');require('./database');syncUsers().then(()=>process.exit(0)).catch(()=>process.exit(1))\"",
    "sync:vendors": "set DB_TYPE=mysql&& node -e \"const {syncVendors}=require('./syncAllToMysql');require('./database');syncVendors().then(()=>process.exit(0)).catch(()=>process.exit(1))\"",
    "sync:products": "set DB_TYPE=mysql&& node -e \"const {syncProducts}=require('./syncAllToMysql');require('./database');syncProducts().then(()=>process.exit(0)).catch(()=>process.exit(1))\"",
    "sync:orders": "set DB_TYPE=mysql&& node -e \"const {syncOrders}=require('./syncAllToMysql');require('./database');syncOrders().then(()=>process.exit(0)).catch(()=>process.exit(1))\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:fleet": "node test_fleet_realtime.js",
    "seed:fleet": "node seed_fleet_data.js",
    "verify:gates": "node verify_fleet_gates.js",
    "check:data": "node check_fleet_data.js",
    "setup:db": "node setup_trading_realestate_db.js"
  },
  "keywords": [
    "node",
    "express",
    "mysql",
    "socketio",
    "qr-queue"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ixjb94/indicators": "^1.2.4",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^105.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.2",
    "node-cron": "^3.0.3",
    "socket.io": "^4.7.2",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "yahoo-finance2": "^2.4.0"
  }
}
