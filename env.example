# Copy to backend/.env for local dev or set these in your host (Render, etc.)

# mysql = read/write TiDB/MySQL online | inmemory = fast local (still mirrors if DB_HOST set)
DB_TYPE=mysql

DB_HOST=your-mysql-host.example.com
DB_PORT=4000
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=qr_queue
DB_SSL=true

# Auto-sync in-memory seed → MySQL on startup and retry until complete
AUTO_SYNC_ON_STARTUP=true
SYNC_INTERVAL_MINUTES=30
SYNC_RETRY_DELAY_MS=60000
SYNC_ENSURE_DEBOUNCE_MS=30000
SYNC_RECENT_DEBOUNCE_MS=180000

# Optional: track deploy version in sync_runs
BUILD_VERSION=

PORT=5000
