# Copy to backend/.env for local dev or set these in your host (Render, etc.)

# mysql = read/write TiDB/MySQL online | inmemory = fast local (still mirrors if DB_HOST set)
DB_TYPE=mysql

DB_HOST=your-mysql-host.example.com
DB_PORT=4000
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=qr_queue
DB_SSL=true

# Auto-sync in-memory seed → MySQL on startup and retry until complete
AUTO_SYNC_ON_STARTUP=true
AUTO_DRIFT_SYNC=true
SYNC_INTERVAL_MINUTES=30
SYNC_DRIFT_INTERVAL_MINUTES=15
SYNC_DRIFT_DEBOUNCE_MS=120000
SYNC_RETRY_DELAY_MS=300000
MYSQL_RETRY_DELAY_MS=300000
NEWS_SLICE_ATTEMPTS=3
MARKETPLACE_SLICE_ATTEMPTS=3
SYNC_ENSURE_DEBOUNCE_MS=30000
SYNC_RECENT_DEBOUNCE_MS=180000

# Optional: track deploy version in sync_runs
BUILD_VERSION=

# Trading Excel sync (Windows server with local workbook)
EXCEL_FILE_PATH=./India_Stock_Market_Tracker_v1.0.xlsx
EXCEL_OPEN_BEFORE_SYNC=true
EXCEL_LOAD_WAIT_MS=240000
EXCEL_REFRESH_WAIT_MS=180000
EXCEL_PREFER_LOCAL=true
EXCEL_SYNC_ENABLED=true
EXCEL_SYNC_CRON=*/35 * * * *
