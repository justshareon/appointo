# Template → copy to backend/.env (server only). Do NOT create SMART-only or per-module .env files.
#
# This repo uses two runtime env files only:
#   ../.env           Expo / app UI (EXPO_PUBLIC_* — see ../env.example)
#   backend/.env      Node backend (this file — DB, SMART_*, sync, secrets)
#
# SGATE / SMART_* variables belong here with all other backend keys.

# mysql = read/write TiDB/MySQL online | inmemory = fast local (still mirrors if DB_HOST set)
DB_TYPE=mysql

# SGATE: mic in memory; camera also MySQL when DB_TYPE=mysql. Retention default 1d (override in super-admin settings too).
# SMART_CAMERA_AI_DEFAULT=true   # vendor AI/recording ON by default (unset = true). Set false for live-only default.
# SMART_CAMERA_MEMORY_ONLY=true
# SMART_LIVE_RETENTION_DAYS=1
# SMART_DEMO_SEED=true   # local only — inserts smart1@test.com + v_smart1 demo rows; leave unset on production

DB_HOST=your-mysql-host.example.com
DB_PORT=4000
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=qr_queue
DB_SSL=true

# Auto-sync in-memory seed → MySQL on startup and retry until complete
AUTO_SYNC_ON_STARTUP=true
AUTO_DRIFT_SYNC=true
SYNC_INTERVAL_MINUTES=30
SYNC_DRIFT_INTERVAL_MINUTES=15
# Recent activity window for drift/cron + manual recent sync (hours)
SYNC_RECENT_HOURS=2
SYNC_DRIFT_DEBOUNCE_MS=120000
SYNC_RETRY_DELAY_MS=300000
MYSQL_RETRY_DELAY_MS=300000
NEWS_SLICE_ATTEMPTS=3
MARKETPLACE_SLICE_ATTEMPTS=3
SYNC_ENSURE_DEBOUNCE_MS=30000
SYNC_RECENT_DEBOUNCE_MS=180000

# Optional: track deploy version in sync_runs
BUILD_VERSION=

# Trading Excel sync (Windows server with local workbook)
EXCEL_FILE_PATH=./India_Stock_Market_Tracker_v1.0.xlsx
EXCEL_OPEN_BEFORE_SYNC=true
EXCEL_LOAD_WAIT_MS=240000
EXCEL_REFRESH_WAIT_MS=180000
EXCEL_PREFER_LOCAL=true
EXCEL_SYNC_ENABLED=true
EXCEL_SYNC_CRON=*/35 * * * *
